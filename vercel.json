{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && cd apps/dashboard && npm install --include=dev",
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/:match*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|svg|webp|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/delhivery/:action*", "destination": "/api/delhivery?action=:action" },
    { "source": "/login", "destination": "/app.html" },
    { "source": "/signup", "destination": "/app.html" },
    { "source": "/register", "destination": "/app.html" },
    { "source": "/forgot-password", "destination": "/app.html" },
    { "source": "/reset-password", "destination": "/app.html" },
    { "source": "/auth/:path*", "destination": "/app.html" },
    { "source": "/admin", "destination": "/app.html" },
    { "source": "/admin/(.*)", "destination": "/app.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/(.*)", "destination": "/app.html" },
    { "source": "/track", "destination": "/app.html" },
    { "source": "/track/(.*)", "destination": "/app.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/terms-conditions", "destination": "/terms-conditions.html" },
    { "source": "/refund-policy", "destination": "/refund-policy.html" },
    { "source": "/shipping-policy", "destination": "/shipping-policy.html" },
    { "source": "/contact-us", "destination": "/contact-us.html" }
  ]
}
