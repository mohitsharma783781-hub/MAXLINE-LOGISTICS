# Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL / Supabase Database Connection (Prisma Dual-URL Configuration)
# 1. DATABASE_URL: Supabase Connection Pooler (Transaction mode, port 6543) with ?pgbouncer=true
#    Used by Prisma Client for runtime queries. IPv4-compatible via aws-0-*.pooler.supabase.com.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"

# 2. DIRECT_URL: Supabase Direct or Session Pooler connection (port 5432)
#    Used by Prisma CLI for migrations and schema introspection (requires session-level locking).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=public"

# Authentication Security Configuration
# Cryptographic secret key used to sign and verify authentication JWTs
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-characters"
JWT_EXPIRES_IN="1d"

# Razorpay Standard Payment Gateway Configuration
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"


